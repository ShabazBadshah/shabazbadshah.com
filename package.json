{
  "name": "shabazbadshah.github.io",
  "version": "5.0.0",
  "author": "Shabaz Badshah <badshah.shabaz@gmail.com>",
  "description": "My personal site on the internet",
  "license": "MIT",
  "private": "true",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4"
  ],
  "scripts": {
    "generate": "ts-node ./bin/copy-blog-images-to-public.ts && ts-node ./bin/generate.ts",
    "dev": "pnpm generate && next dev",
    "build": "pnpm generate && next build",
    "start": "next start",
    "export": "next export",
    "build:analyze": "cross-env ANALYZE=true pnpm run build",
    "lint": "eslint '{src,pages}**/*.{js,jsx,ts,tsx}'",
    "prettier": "prettier --write '{src,pages}**/*.{js,jsx,ts,tsx}'",
    "precommit": "pnpm run lint && pnpm run prettier && pnpm build",
    "commit": "cz"
  },
  "dependencies": {
    "@babel/core": "^7.12.10",
    "babel-loader": "^8.2.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.19",
    "dotenv": "^8.2.0",
    "framer-motion": "^14.2.0",
    "fs-extra": "^10.1.0",
    "glob": "^7.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "next": "^12.0.10",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "prettier": "^2.8.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^4.1.3",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^16.0.0",
    "@next/bundle-analyzer": "^10.2.3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^7.2.0",
    "@types/gtag.js": "^0.0.10",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^18.7.6",
    "@types/prettier": "^2.4.4",
    "@types/react": "^17.0.38",
    "@types/react-dom": "^17.0.0",
    "@types/styled-components": "^5.1.15",
    "@typescript-eslint/eslint-plugin": "^4.9.1",
    "@typescript-eslint/parser": "^4.9.1",
    "autoprefixer": "^10.4.27",
    "commitizen": "^4.2.4",
    "commitlint": "^16.0.1",
    "cz": "^1.8.2",
    "eslint": "^7.15.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier": "^3.2.0",
    "next-transpile-modules": "^9.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.8.2",
    "webpack": "^5.68.0",
    "webpack-cli": "^4.9.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
